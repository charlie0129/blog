#!/bin/sh
# 60-sysctl - make the kernel actually use zram, and enable BBR.
set -eu

cat >/etc/sysctl.d/01-zram.conf <<'EOF'
# Compressed swap in RAM is cheap, so be far more willing to use it than the
# defaults assume (they are tuned for spinning disks).
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
# Reading ahead on swap-in is pointless when "swap" is a RAM device.
vm.page-cluster = 0
EOF

if [ "$ENABLE_BBR" = yes ]; then
	cat >/etc/sysctl.d/02-bbr.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
fi
