#!/bin/sh
# 80-firstboot - regenerate the per-machine identity that mkalpine.sh
# deliberately stripped out of the image.
#
# The image is a template. Anything unique baked into it stops being unique
# the moment it is cloned, so it has to be created on the machine instead.
set -eu

cat >/etc/init.d/firstboot <<'EOF'
#!/sbin/openrc-run

description="Generate per-machine identity on first boot"

depend() {
	need root localmount
	# hostname first, so the host keys ssh-keygen generates below are
	# commented "root@<hostname>" rather than "root@(none)".
	after seedrng bootmisc hostname
	# The DHCP DUID is derived from the machine-id, and sshd needs its host
	# keys, so both have to exist before those two start.
	before networking sshd
}

start() {
	if [ ! -s /etc/machine-id ]; then
		ebegin "Generating /etc/machine-id"
		head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' >/etc/machine-id
		echo >>/etc/machine-id
		chmod 0444 /etc/machine-id
		eend $?
	fi

	if [ -d /var/lib/dbus ] && [ ! -s /var/lib/dbus/machine-id ]; then
		cp /etc/machine-id /var/lib/dbus/machine-id
	fi

	if command -v ssh-keygen >/dev/null 2>&1; then
		set -- /etc/ssh/ssh_host_*_key
		if [ ! -f "$1" ]; then
			ebegin "Generating SSH host keys"
			ssh-keygen -A >/dev/null 2>&1
			eend $?
		fi
	fi

	return 0
}
EOF

chmod +x /etc/init.d/firstboot
rc-update add firstboot boot >/dev/null
