# DAMON: data access monitoring, its sysfs interface, and the two reclaim
# modules built on it.
#
# 66-vmmem's VMMEM_DAMON_RECLAIM sets up a physical-address kdamond through
# the sysfs interface that pages out memory not accessed for a while, with a
# bounded CPU budget: the time-based, container-like footprint that free page
# reporting alone cannot give a VM. It needs DAMON, DAMON_PADDR and
# DAMON_SYSFS; the damon_reclaim and damon_lru_sort modules are built too, for
# experimenting. None of Alpine's kernels enable CONFIG_DAMON. See
# https://charlie0129.github.io/p/vm-memory-give-back/
#
# Lines here are appended to the flavour's config and then resolved by
# olddefconfig; the build fails if any CONFIG_X=y below is missing from the
# final .config.
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y
