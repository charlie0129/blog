# DAMON: data access monitoring and the two reclaim schemes built on it.
#
# damon_reclaim pages out memory that has not been accessed for min_age
# (default 2 min) with a bounded CPU budget, which is the time-based,
# container-like footprint that free page reporting alone cannot give a VM.
# None of Alpine's kernels build it. See
# https://charlie0129.github.io/p/vm-memory-give-back/
#
# Lines here are appended to the flavour's config and then resolved by
# olddefconfig; the build fails if any CONFIG_X=y below is missing from the
# final .config.
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y
